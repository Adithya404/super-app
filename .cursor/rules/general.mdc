```

## Component Architecture

### Client vs Server Components

- Most components are **client components** (`'use client'`) due to interactivity
- Use **Server Components** for static layout shells
- `PageLayoutTemplate` includes `ErrorBoundary` and `Suspense` internally

### React 19 Features

```typescript
// use() hook for reading promises in client components
import { use } from 'react';

function Component({ dataPromise }: { dataPromise: Promise<Data> }) {
  const data = use(dataPromise);
  return <div>{data.name}</div>;
}

// Async params in layouts/pages
export default async function Page({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  // ...
}
```

## Store Patterns

### Dialog Pattern

```typescript
'use client';

import { useState, useCallback } from 'react';
import { Popup, Button } from '@/components/ui/...';
import { useCurrentRowSync, useIsStoreDirty, useIsStorePosting } from '@/lib/common/store';
import type { Entity } from '@/lib/common/ds/types/module/Entity';
import type { Store } from '@/lib/common/store';

interface Props {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  store: Store<Entity>;
}

export function EntityDialog({ open, onOpenChange, store }: Props) {
  const row = useCurrentRowSync(store);
  const isDirty = useIsStoreDirty(store);
  const isPosting = useIsStorePosting(store);

  const handleSave = async () => {
    await store.save({ feedback: 'Entity saved' });
    onOpenChange(false);
  };

  const handleClose = () => {
    store.resetStore();  // Discard unsaved changes
    onOpenChange(false);
  };

  if (!open) return null;

  return (
    <Popup
      title="Add Entity"
      onClose={handleClose}
      width={520}
      height={430}
      footer={
        <>
          <Button variant="outline" onClick={handleClose} disabled={isPosting}>Cancel</Button>
          <Button onClick={handleSave} disabled={isPosting || !isDirty || !row}>Save</Button>
        </>
      }
    >
      {row && (
        <div className="grid gap-4">
          <TextInput label="Name" store={store} attributeCode="name" required />
          <TextInput label="Description" store={store} attributeCode="description" />
        </div>
      )}
    </Popup>
  );
}

// Usage
function ParentComponent() {
  const store = useEntityStore();
  const [isDialogOpen, setIsDialogOpen] = useState(false);

  // ✅ Initialize BEFORE opening dialog (not in useEffect)
  const handleAdd = useCallback(() => {
    store.createNew({ partialRecord: { status: 'draft' } });
    setIsDialogOpen(true);
  }, [store]);

  return (
    <>
      <Button onClick={handleAdd}>Add Entity</Button>
      <EntityDialog open={isDialogOpen} onOpenChange={setIsDialogOpen} store={store} />
    </>
  );
}
```

### Anti-Patterns

```typescript
// ❌ Don't use store methods during render (non-reactive)
const rows = store.rows();
const row = store.currentRow;

// ✅ Use reactive hooks
const rows = useDBRows(store);
const row = useCurrentRowSync(store);

// ❌ Don't call executeQuery/refresh after save
await store.save();
await store.executeQuery();  // ❌ Unnecessary

// ✅ Just save (auto-refreshes)
await store.save();

// ❌ Don't init createNew in useEffect
useEffect(() => {
  if (open) store.createNew({ ... });  // ❌ Wrong
}, [open]);

// ✅ Init in event handler
const handleAdd = () => {
  store.createNew({ ... });
  setOpen(true);  // ✅ Correct
};

// ❌ Don't use useCurrentRow for form inputs (causes cursor jumping)
const row = useCurrentRow(store);

// ✅ Use sync mode for forms
const row = useCurrentRowSync(store);
```

## Styling Guidelines

- **Tailwind CSS v4** for all styling (no CSS files)
- Use `cn()` utility for conditional class names
- Scrollable regions should use: `scrollbar-thin scrollbar-track-transparent scrollbar-thumb-muted-foreground/20 hover:scrollbar-thumb-muted-foreground/40`
- Form fields side-by-side: use `grid grid-cols-2 items-start gap-4` for proper alignment

## Quality Assurance

### Before Committing

```bash
# Type checking
pnpm typecheck

# Linting and formatting
pnpm exec biome check --write <changed paths>

# Full repo check
pnpm check
pnpm typecheck
```

**All must pass before reporting work complete.**

## Don'ts

- ❌ Don't use `npm` / `yarn` — always use `pnpm`
- ❌ Don't create CSS files — use Tailwind classes only
- ❌ Don't read `store.rows()` or `store.currentRow` during render — use hooks
- ❌ Don't call `executeQuery()` or `refresh()` after `save()` on the same store
- ❌ Don't initialize dialogs in `useEffect` — call `createNew` before opening
- ❌ Don't use `any` without justification
- ❌ Don't use TypeScript enums — use `as const` maps
- ❌ Don't leave TODOs or placeholder comments in committed code
- ❌ Don't import `uuid` — use `generateUUID()` from `@wayvo-ai/core/common`
- ❌ Don't use `console.log` on the server — use `logger`
- ❌ Don't use default exports for components
