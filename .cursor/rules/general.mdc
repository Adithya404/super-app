// Server utilities (server components/actions only)
import logger from "@wayvo-ai/core/server/logger";
```

**Use `@/` for all `src/` imports. Prefer named exports.**

## Code Style

### General Principles

- Functional components with early returns
- `interface` for extendable object shapes; `type` for unions and utility types
- No TypeScript enums — use `as const` maps
- Descriptive boolean names: `isLoading`, `hasError`, `canSubmit`
- Handler functions prefixed: `handleClick`, `handleSave`, `handleSubmit`
- Always add copyright header to new files: `/* Copyright (c) 2024-present ... */`

### TypeScript Types vs Interfaces

```typescript
// Use interface for extendable object shapes
interface User {
  id: string;
  name: string;
}

interface AdminUser extends User {
  permissions: string[];
}

// Use type for unions, intersections, utility types
type Status = 'active' | 'inactive' | 'pending';
type UserWithStatus = User & { status: Status };
```

### Avoid Enums - Use Const Maps

```typescript
// ❌ Don't use enums
enum Status {
  Active = 'active',
  Inactive = 'inactive',
}

// ✅ Use const maps
const STATUS = {
  Active: 'active',
  Inactive: 'inactive',
} as const;

type Status = (typeof STATUS)[keyof typeof STATUS];
```

### Naming Conventions

- Directories: lowercase with dashes (`components/auth-wizard`, `lib/common`)
- Components: PascalCase (`UserForm`, `EditDialog`)
- Functions/hooks: camelCase (`getUserData`, `useEntityStore`)
- Variables: camelCase (`isLoading`, `userData`)
- Database columns: snake_case (`created_at`, `user_id`)
- Constants: UPPERCASE_SNAKE_CASE (`API_KEY`, `MAX_RETRIES`)

## Data Fetching Decision Tree

### Decision Matrix

1. **Use `useStore` with DataSource** when:
   - Basic CRUD operations (create, read, update, delete)
   - Lists/tables with filtering, sorting, pagination
   - Single-entity operations where a DataSource exists
   - **Status**: Auto-managed by store (loading, posting, dirty)

2. **Use Server Actions** when:
   - Complex aggregations or joins across multiple tables
   - Dashboard statistics and reports
   - Complex business logic with multiple queries
   - Operations that don't map to a single DataSource

3. **Use API Routes (`route.ts`)** only when:
   - Webhooks from external services
   - Public endpoints (no auth required)
   - External API integrations
   - File uploads/downloads with streaming

### Store Usage Example

```typescript
// 1. Create a custom store hook
export function useEntityStore() {
  return useStore<Entity>({
    datasourceId: 'Entity',
    page: 'entity-page',
    alias: 'entity-list',
    limit: 20,
    includeCount: true,
    autoQuery: true,
    sort: { createdAt: -1 },
  });
}

// 2. Use in components
const store = useEntityStore();
const rows = useDBRows(store);
const isLoading = useIsStoreLoading(store);

// 3. For forms - ALWAYS use useCurrentRowSync to prevent cursor jumping
const row = useCurrentRowSync(store);

// 4. Save (auto-refreshes, no manual refresh needed)
await store.save({ feedback: 'Entity saved' });
```

