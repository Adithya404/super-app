## Anti-Patterns to Avoid

### ❌ Don't use store methods during render (non-reactive)

```typescript
// ❌ Wrong - won't re-render when data changes
function MyComponent({ store }: Props) {
  const rows = store.rows();
  const isLoading = store.isLoading();
  return <div>{rows.length} items</div>;
}

// ✅ Correct - subscribes to changes
function MyComponent({ store }: Props) {
  const rows = useDBRows(store);
  const isLoading = useIsStoreLoading(store);
  return <div>{rows.length} items</div>;
}
```

### ❌ Don't call executeQuery/refresh after save

```typescript
// ❌ Wrong - unnecessary, save auto-refreshes
await store.save();
await store.executeQuery();

// ✅ Correct - just save
await store.save({ feedback: 'Saved' });

// ✅ Only refresh a DIFFERENT store (cascade delete)
await parentStore.save();
childStore.refresh();  // Different store needed
```

### ❌ Don't use useCurrentRow for form fields

```typescript
// ❌ Wrong - causes cursor jumping
const row = useCurrentRow(store);

// ✅ Correct - sync mode for forms
const row = useCurrentRowSync(store);
```

### ❌ Don't initialize dialogs in useEffect

```typescript
// ❌ Wrong - timing issues
useEffect(() => {
  if (open) store.createNew({ ... });
}, [open]);

// ✅ Correct - initialize in click handler
const handleAdd = () => {
  store.createNew({ ... });
  setOpen(true);
};
```

### ❌ Don't create multiple stores with same key

```typescript
// ❌ Wrong - second config ignored
const store1 = useStore({ datasourceId: 'Users', alias: 'list', limit: 20 });
const store2 = useStore({ datasourceId: 'Users', alias: 'list', limit: 50 });

// ✅ Correct - different alias
const listStore = useStore({ datasourceId: 'Users', alias: 'users-list', limit: 20 });
const exportStore = useStore({ datasourceId: 'Users', alias: 'users-export', limit: 1000 });
```

### ❌ Don't skip await on deleteRow

```typescript
// ❌ Wrong - row only marked for deletion
store.deleteRow(rowId);
await store.save();

// ✅ Correct - await both
await store.deleteRow(rowId);
await store.save();
```

---

## Performance Tips

1. Use `select` for ComboboxInput stores — only fetch needed fields
2. Use `limit` appropriately — don't fetch more than needed
3. Share stores via same key — avoid duplicate fetches
4. Use `autoQuery: false` for dialogs/pickers (manual query on demand)
5. Use `includeCount: true` only when pagination is needed
