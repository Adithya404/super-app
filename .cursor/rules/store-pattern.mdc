## Store Methods (CRUD)

### Creating New Records

**⚠️ Initialize BEFORE opening dialogs, not in useEffect.**

```typescript
import { generateUUID } from "@wayvo-ai/core/common";

// ✅ Correct - Initialize in click handler
const handleAdd = useCallback(() => {
  store.createNew({
    partialRecord: { id: generateUUID(), status: 'draft' },  // Set defaults
  });
  setIsDialogOpen(true);
}, [store]);

// ❌ Wrong - Causes timing issues
useEffect(() => {
  if (open) {
    store.createNew({ partialRecord: { status: 'draft' } });
  }
}, [open, store]);
```

### Editing Existing Records

```typescript
const handleEdit = useCallback((row: Entity) => {
  store.setCurrentRow(row);  // Or store.setCurrentRowId(row._id)
  setIsDialogOpen(true);
}, [store]);
```

### Updating Field Values

```typescript
// Update current row
store.setValue('name', 'New Name');

// Update specific row
store.setValue('name', 'New Name', rowId);

// Update multiple fields
store.updateRow(rowId, {
  name: 'New Name',
  status: 'active',
});
```

### Saving Changes

```typescript
// Basic save (shows "X rows saved" message)
const success = await store.save();

// With custom feedback message
await store.save({ feedback: 'Entity saved successfully' });

// No feedback (silent save)
await store.save({ feedback: 'NONE' });
```

**Important:** After `save()`, the store **automatically refreshes**. Do NOT call `executeQuery()` or `refresh()`.

### Deleting Records

```typescript
// Mark for deletion and save
await store.deleteRow(rowId);
await store.save({ feedback: 'Entity deleted' });

// With confirmation
import { confirmWithUser } from '@/components/ui/...';

const handleDelete = useCallback(async (entity: Entity) => {
  const confirmed = await confirmWithUser({
    title: 'Delete Entity',
    content: `Delete "${entity.name}"? This cannot be undone.`,
  });
  if (confirmed) {
    await store.deleteRow(entity.id);
    await store.save({ feedback: 'Entity deleted' });
  }
}, [store]);
```

### Querying Data

```typescript
// Auto-query on mount (via autoQuery: true)
// OR manual query:
await store.executeQuery();

// With filters
await store.executeQuery({
  query: {
    match: { projectId: 'abc123' },  // ✅ Use match for equality
    filters: [{ status: { is: 'active' } }],  // Complex operators
    sort: { name: 1 },
  },
});

// Force refresh (bypass cache)
await store.executeQuery({ force: true });

// Pagination
await store.next();         // Next page
await store.goToPage(2);    // Go to specific page
```

### Refreshing Data

```typescript
// Re-fetch with current filters/sort/offset
await store.refresh();

// Refresh a specific row
await store.refreshRow(rowId);

// When child store was cascade-deleted
parentStore.save();
childStore.refresh();  // Different store, so refresh needed
```

### Resetting Changes

```typescript
// Discard all unsaved changes
store.resetStore();

// Clear all data
store.clearSync();
```

